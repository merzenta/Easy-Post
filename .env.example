# ==============================================================
# EasyPost x Wix Custom Shipping Rates App Environment Template
# ==============================================================

# --------------------------------------------------------------
# 1. EasyPost API Credentials (Default / Sandbox)
# --------------------------------------------------------------
# Test Mode Key starts with EZTK..., Production Key starts with EZAK...
EASYPOST_API_KEY="EZTK..."

# --------------------------------------------------------------
# 2. Database (PostgreSQL via Prisma ORM) - REQUIRED
# --------------------------------------------------------------
# The application requires a PostgreSQL database connection string.
# Examples:
# Neon:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------------
# 3. Credential Encryption Key (AES-256-GCM)
# --------------------------------------------------------------
# 64-char hex key for AES-256-GCM credential encryption.
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --------------------------------------------------------------
# 4. Wix App Credentials
# --------------------------------------------------------------
WIX_APP_ID="your-wix-app-id"
WIX_APP_SECRET="your-wix-app-secret"
WIX_APP_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --------------------------------------------------------------
# 5. Application Logging
# --------------------------------------------------------------
LOG_DIR="logs"
